<?xml version="1.0" encoding="utf-8"?>
<!-- "Card Swap" logo: two cards trading places inside a circle of arrows, on a 108dp adaptive-icon canvas.
     Drawn on the same 100-unit grid as the website's icon (web/src/app/icon.svg), scaled by 0.84 and centred so
     everything stays inside the 66dp safe zone that round and squircle launcher masks keep. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.84"
        android:scaleY="0.84"
        android:translateX="12"
        android:translateY="12">
        <!-- back card -->
        <group android:rotation="10" android:pivotX="58" android:pivotY="44">
            <path
                android:fillColor="#FF7E57C2"
                android:pathData="M47,23 h22 a4,4 0 0 1 4,4 v34 a4,4 0 0 1 -4,4 h-22 a4,4 0 0 1 -4,-4 v-34 a4,4 0 0 1 4,-4 z" />
        </group>
        <!-- front card with its art box -->
        <group android:rotation="-10" android:pivotX="42" android:pivotY="56">
            <path
                android:fillColor="#FFE0A526"
                android:pathData="M31,35 h22 a4,4 0 0 1 4,4 v34 a4,4 0 0 1 -4,4 h-22 a4,4 0 0 1 -4,-4 v-34 a4,4 0 0 1 4,-4 z" />
            <path
                android:fillColor="#FF1F1A2E"
                android:pathData="M32.5,39 h19 a1.5,1.5 0 0 1 1.5,1.5 v13 a1.5,1.5 0 0 1 -1.5,1.5 h-19 a1.5,1.5 0 0 1 -1.5,-1.5 v-13 a1.5,1.5 0 0 1 1.5,-1.5 z" />
        </group>
        <!-- swap arrows -->
        <path
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="4"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M80,58 A31,31 0 0 1 62,80 M68,82 L62,80 L64,74" />
        <path
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="4"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M20,42 A31,31 0 0 1 38,20 M32,18 L38,20 L36,26" />
    </group>
</vector>
