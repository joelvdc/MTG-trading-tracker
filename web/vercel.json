{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- .",
  "crons": [
    {
      "path": "/api/cron/prices",
      "schedule": "30 5 * * *"
    },
    {
      "path": "/api/cron/sources",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/backup",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cron/categories",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/nightly",
      "schedule": "30 6 * * *"
    }
  ]
}
